# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# --- LLM ---
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Use ONE of these two:
# 1) Password or programmatic access token (PAT)
SNOWFLAKE_PASSWORD=your-password-or-token
# 2) Key-pair auth (leave the password empty if you use this)
# SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8

# --- Data (free sample data that comes with every Snowflake account) ---
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1
