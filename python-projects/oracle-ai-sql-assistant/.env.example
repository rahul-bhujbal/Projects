# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# --- LLM ---
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Oracle ---
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password
# host:port/service_name  (local Oracle XE 21c: localhost:1521/XEPDB1)
ORACLE_DSN=localhost:1521/XEPDB1

# Schema to query (defaults to ORACLE_USER). Optional table list, comma-separated.
# ORACLE_SCHEMA=SALES_DEMO
# ORACLE_TABLES=REGIONS,CUSTOMERS,PRODUCTS,ORDERS,ORDER_ITEMS

# --- Only for Oracle Autonomous Database (wallet / mTLS) ---
# ORACLE_DSN=mydb_high
# ORACLE_WALLET_DIR=D:/oracle/wallet_mydb
# ORACLE_WALLET_PASSWORD=your_wallet_password

# --- Only for Oracle 11.2 or older (thick mode) ---
# Folder that contains oci.dll from 64-bit Oracle Instant Client 19
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19_29
