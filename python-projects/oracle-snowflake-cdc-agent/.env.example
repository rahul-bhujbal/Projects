# Copy to .env and adjust.  cp .env.example .env

# Oracle (local container)
ORACLE_PASSWORD=OracleLocal123
SAPSD_PASSWORD=sapsd

# Image / connector versions
DEBEZIUM_VERSION=3.4
SNOWFLAKE_CONNECTOR_VERSION=4.2.2

# From the last query in snowflake/snowflake_setup.sql, e.g.
# https://myorg-myaccount.snowflakecomputing.com
SNOWFLAKE_URL=https://<org>-<account>.snowflakecomputing.com
