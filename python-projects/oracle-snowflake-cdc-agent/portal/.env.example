# Copy to portal/.env and fill in.   cp portal/.env.example portal/.env

# Snowflake account: org-account, or the full https://<org>-<account>.snowflakecomputing.com URL
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=SAP_PORTAL_USER
SNOWFLAKE_ROLE=SAP_PORTAL_ROLE
SNOWFLAKE_WAREHOUSE=SAP_TRANSFORM_WH

# Key-pair login (recommended; see snowflake/06_portal_access.sql). Path relative to the project folder.
SNOWFLAKE_PRIVATE_KEY_FILE=snowflake/secrets/portal_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Or, for a quick test with your own user instead of the service user:
# SNOWFLAKE_USER=<your login>
# SNOWFLAKE_ROLE=SAP_TRANSFORM_ROLE
# SNOWFLAKE_PRIVATE_KEY_FILE=
# SNOWFLAKE_PASSWORD=<your password>          (or SNOWFLAKE_AUTHENTICATOR=externalbrowser)

# Gold schema the portal reads
GOLD_SCHEMA=SAP_GOLD.SALES

# "Place order" writes to Oracle. Same password as SAPSD_PASSWORD in the project .env (no quotes).
ORACLE_ORDERS_ENABLED=true
SAPSD_PASSWORD=sapsd
ORACLE_HOST=localhost
ORACLE_PORT=1522
ORACLE_SERVICE=FREEPDB1

# AI assistant: Cortex Agent from snowflake/05_sales_agent.sql
CORTEX_AGENT=SAP_GOLD.SALES.SAP_SALES_AGENT
